<Window x:Class="VectorDraw.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VectorDraw" Title="VectorDraw — Grafici vettoriali SVG" Width="1120" Height="720" MinWidth="580" MinHeight="430">
<DockPanel Margin="10"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6"><TextBlock Text="Lingua / Language" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="LanguageBox" Width="140" SelectionChanged="LanguageChanged"><ComboBoxItem Content="Italiano" Tag="it" IsSelected="True"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Français" Tag="fr"/><ComboBoxItem Content="Deutsch" Tag="de"/><ComboBoxItem Content="Español" Tag="es"/></ComboBox></StackPanel><TabControl x:Name="MainTabs"><TabItem Header="Vettori e grafici"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="180"/></Grid.ColumnDefinitions>
<GridSplitter Grid.Column="1" Width="7" Background="#CBD5E1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
<DockPanel Grid.Column="0" Margin="0,0,8,0">
<StackPanel DockPanel.Dock="Top">
<TextBlock Text="VectorDraw" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/>
<TextBlock Text="Spazio vettoriale" FontWeight="SemiBold"/>
<ComboBox x:Name="DimensionBox" SelectionChanged="SettingsChanged" SelectedIndex="1" Margin="0,5,0,12"><ComboBoxItem Content="ℝ¹ — Retta"/><ComboBoxItem Content="ℝ² — Piano"/><ComboBoxItem Content="ℝ³ — Spazio"/></ComboBox>
<TextBlock Text="Vettori (doppio clic per modificare)" FontWeight="SemiBold" Margin="0,0,0,6"/>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
<Button Content="Ripulisci canvas" Click="ClearCanvasClicked" Padding="10,6" Margin="0,0,0,8"/><WrapPanel Margin="0,0,0,8"><Button Content="+ Aggiungi" Click="AddClicked" Padding="10,6" Margin="0,0,8,0"/><Button Content="Modifica" Click="EditClicked" Padding="10,6" Margin="0,0,8,0"/><Button Content="− Rimuovi" Click="RemoveClicked" Padding="10,6"/></WrapPanel>
<CheckBox x:Name="GridCheck" Content="Mostra griglia" IsChecked="True" Click="SettingsChanged" Margin="0,0,0,7"/>
<CheckBox x:Name="ComponentsCheck" Content="Mostra vettori componenti" IsChecked="False" Click="SettingsChanged" Margin="0,0,0,7"/><CheckBox x:Name="GuidesCheck" Content="Tratteggi del parallelepipedo" IsChecked="True" Click="SettingsChanged" Margin="0,0,0,7"/><CheckBox x:Name="NamesCheck" Content="Mostra nomi" IsChecked="True" Click="SettingsChanged" Margin="0,0,0,7"/>
<TextBlock Text="Scala"/><Slider x:Name="ScaleSlider" Minimum="0.001" Maximum="10000" Value="45" ValueChanged="SettingsChanged" Margin="0,0,0,10"/>
<WrapPanel Margin="0,0,0,8"><Button Content="−" ToolTip="Riduci zoom" Click="ZoomOutClicked" Padding="12,5" Margin="0,0,7,0"/><Button Content="+" ToolTip="Aumenta zoom" Click="ZoomInClicked" Padding="12,5" Margin="0,0,7,0"/><Button x:Name="FitButton" Content="Adatta vettori" Click="FitClicked" Padding="10,5"/></WrapPanel>
<TextBlock Text="In ℝ³ trascina sull'anteprima per ruotare." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>
<WrapPanel><Button Content="Esporta SVG" Click="ExportClicked" Padding="12,8" Margin="0,0,8,8"/><Button Content="Salva progetto" Click="SaveClicked" Padding="12,8" Margin="0,0,8,8"/><Button Content="Apri progetto" Click="OpenClicked" Padding="12,8" Margin="0,0,8,8"/></WrapPanel>
<TextBlock x:Name="Status" Foreground="DarkSlateGray" TextWrapping="Wrap"/>
</StackPanel>
<DataGrid x:Name="VectorGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" IsReadOnly="True" MouseDoubleClick="VectorDoubleClicked">
<DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="Componenti" Binding="{Binding Components, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTemplateColumn Header="Colore" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Rectangle Width="22" Height="14" Fill="{Binding Color}" Stroke="#999" Margin="0,0,5,0"/><TextBlock Text="●" Foreground="{Binding Color}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
</DataGrid>
</DockPanel>
<Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" CornerRadius="6"><Canvas x:Name="DrawingCanvas" ClipToBounds="True" SizeChanged="CanvasResized" MouseLeftButtonDown="CanvasDown" MouseLeftButtonUp="CanvasUp" MouseMove="CanvasMove" MouseWheel="CanvasWheel"/></Border>
</Grid></TabItem><TabItem Header="Funzioni"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" MaxWidth="620" HorizontalAlignment="Left">
<TextBlock Text="Equazione (usa * per moltiplicare e ^ per le potenze)" TextWrapping="Wrap" Margin="0,0,0,8"/>
<TextBox x:Name="EquationBox" Text="y = x^2 - 2*x - 3" FontSize="17" Padding="8" Width="480" HorizontalAlignment="Left"/>
<TextBlock Text="Esempi: y=sin(x), x^2+y^2=25, z=sin(x)*cos(y), x^2+y^2+z^2=25" Margin="0,8,0,14" TextWrapping="Wrap"/>
<TextBlock Text="Curve parametriche 3D: inserisci x=cos(t); y=sin(t); z=t (separate da ;)" TextWrapping="Wrap" Margin="0,0,0,10"/>
<TextBlock Text="Intervallo di disegno (coordinate o parametro t)" Margin="0,0,0,6"/>
<StackPanel Orientation="Horizontal"><TextBox x:Name="RangeMinBox" Text="-10" Width="90" Padding="6"/><TextBlock Text=" a " VerticalAlignment="Center" Margin="8,0"/><TextBox x:Name="RangeMaxBox" Text="10" Width="90" Padding="6"/></StackPanel>
<TextBlock Text="Colore della curva" Margin="0,14,0,6"/><ComboBox x:Name="EquationColorBox" Width="210" Height="32" HorizontalAlignment="Left"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Rectangle Width="20" Height="16" Fill="{Binding Brush}" Stroke="#888" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<TextBlock Text="Curve inserite (doppio clic per modificare)" FontWeight="SemiBold" Margin="0,18,0,6"/>
<DataGrid x:Name="CurveGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="160" SelectionMode="Single" MouseDoubleClick="CurveDoubleClicked">
<DataGrid.Columns>
<DataGridTextColumn Header="Equazione" Binding="{Binding Equation}" Width="*"/>
<DataGridTextColumn Header="Da" Binding="{Binding Minimum}" Width="55"/>
<DataGridTextColumn Header="A" Binding="{Binding Maximum}" Width="55"/>
<DataGridTemplateColumn Header="Colore" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><Rectangle Width="22" Height="14" Fill="{Binding Color}" Stroke="#888"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>
<WrapPanel Margin="0,10,0,0"><Button Content="+ Aggiungi" Click="PlotEquationClicked" Padding="12,8" Margin="0,0,8,0"/><Button Content="Modifica" Click="EditCurveClicked" Padding="12,8" Margin="0,0,8,0"/><Button Content="− Rimuovi" Click="RemoveCurveClicked" Padding="12,8"/></WrapPanel>
<TextBlock x:Name="EquationStatus" TextWrapping="Wrap" Margin="0,14,0,0"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="Matrici"><local:MatrixWorkspace x:Name="Matrices"/></TabItem></TabControl></DockPanel></Window>