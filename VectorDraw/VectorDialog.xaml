<Window x:Class="VectorDraw.VectorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vettore" Width="380" Height="610" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
<Window.Resources><Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="7"/></Style></Window.Resources>
<DockPanel Margin="20">
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Annulla" Width="90" Margin="0,0,8,0" IsCancel="True"/><Button Content="Conferma" Width="90" IsDefault="True" Click="ConfirmClicked"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Nome del vettore"/><TextBox x:Name="NameBox"/>
<TextBlock Text="Componente x"/><TextBox x:Name="XBox"/>
<StackPanel x:Name="YPanel"><TextBlock Text="Componente y"/><TextBox x:Name="YBox"/></StackPanel>
<StackPanel x:Name="ZPanel"><TextBlock Text="Componente z"/><TextBox x:Name="ZBox"/></StackPanel>
<TextBlock Text="Colore del vettore" Margin="0,4,0,5"/>
<ComboBox x:Name="ColorBox" Height="32">
<ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Rectangle Width="20" Height="16" Fill="{Binding Brush}" Stroke="#888" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
</ComboBox>
<TextBlock Text="Colori delle componenti (predefinito: colore vettore)" TextWrapping="Wrap" Margin="0,12,0,6"/>
<TextBlock Text="Componente x"/><ComboBox x:Name="XColorBox" Height="28" Margin="0,3,0,8" DisplayMemberPath="Name"/>
<StackPanel x:Name="YColorPanel"><TextBlock Text="Componente y"/><ComboBox x:Name="YColorBox" Height="28" Margin="0,3,0,8" DisplayMemberPath="Name"/></StackPanel>
<StackPanel x:Name="ZColorPanel"><TextBlock Text="Componente z"/><ComboBox x:Name="ZColorBox" Height="28" Margin="0,3,0,8" DisplayMemberPath="Name"/></StackPanel>
<TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0"/>
</StackPanel></ScrollViewer></DockPanel></Window>